# Copy to .env. Never commit .env or private keys. Existing environment overrides this file.
PGHOST=127.0.0.1
PGPORT=5435
PGDATABASE=northstar_bank
PGUSER=aml
PGPASSWORD=
# DATABASE_URL takes precedence over PG* if provided; do not put it in logs.
# DATABASE_URL=postgresql://...
# Snowflake account, database/schema/warehouse and least-privilege role must already exist.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# For unattended jobs use SNOWFLAKE_JWT and a private key outside the repository.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=
# Only used with SNOWFLAKE_AUTHENTICATOR=snowflake, subject to account MFA policy.
SNOWFLAKE_PASSWORD=
